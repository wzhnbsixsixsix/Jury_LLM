# === Jury LLM Environment Configuration ===
# Copy this file to .env and configure your API keys and settings

# === Provider Selection ===
# Uncomment the provider you want to use. The code automatically detects which key is present.

# Option 1: Alibaba DashScope (Qwen models)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Option 2: OpenRouter (Access to multiple AI providers)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Option 3: Generic LLM Provider (Custom endpoint)
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://your-custom-endpoint.com/v1

# === Model Configuration Overrides (Optional) ===
# These environment variables override the settings in config/jury_config.yaml
# Priority: Environment Variables > YAML Config > Defaults

# Override the default model for all operations
# DEFAULT_MODEL=qwen-max

# Override specific judge models by role (推荐方式)
# CHIEF_MODEL=qwen-max              # 首席法官 Chief Justice
# LOGIC_JUDGE_MODEL=qwen-plus       # 逻辑评委 Logic Judge
# EXPRESSION_JUDGE_MODEL=qwen-turbo # 表达评委 Expression Judge
# UTILITY_JUDGE_MODEL=qwen-max      # 实用评委 Utility Judge
# MORAL_JUDGE_MODEL=qwen-plus       # 道德评委 Moral Judge

# === AgentScope Configuration (Optional) ===
# URL for AgentScope Studio interface
# AGENTSCOPE_STUDIO_URL=http://localhost:3000

# === Notes ===
# - For DashScope: Get API key at https://dashscope.console.aliyun.com/
# - For OpenRouter: Get API key at https://openrouter.ai/keys
# - Model names must match the provider's supported models
# - See config/jury_config.yaml for base configuration
# - You can configure different models for each judge role!
