    confirm_btn = gr.Button(
        "✅ Confirm and Continue to Step 3", 
        variant="primary",
        interactive=False
    )
    final_msg = gr.Markdown()
    
    # Event handlers
    use_manual_btn.click(
        fn=on_use_manual_rubrics,
        inputs=[manual_input],
