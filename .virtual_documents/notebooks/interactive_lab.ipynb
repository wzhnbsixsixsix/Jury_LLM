import gradio as gr
from IPython.display import display, Markdown

# Fix for proxy issues with Gradio
os.environ['no_proxy'] = 'localhost,127.0.0.1'
if 'http_proxy' in os.environ: del os.environ['http_proxy']
if 'https_proxy' in os.environ: del os.environ['https_proxy']

# Load configuration
with open('../config/jury_config.yaml', 'r') as f:
    JURY_CONFIG = yaml.safe_load(f)

# Import the new AgentScope-based jury system
from src.agentscope_jury import JuryEvaluationSystem, EvaluationContext

# Initialize the jury system
print('Initializing Jury Evaluation System...')
jury_system = JuryEvaluationSystem(JURY_CONFIG)

# Global state
JURY_STATE = None


#Click button"start jury evaluation"
def run_jury_evaluation_sync(human_score: int, human_reason: str) -> str:
    """
    Run the complete jury evaluation workflow.
    This is a synchronous wrapper for the async evaluation.
    """
    global JURY_STATE
    
    # Validate inputs from previous steps
    try:
        if 'TARGET_TEXT' not in globals() or not TARGET_TEXT:
            return "Error: No TARGET_TEXT found. Please complete Step 1 first."
    except NameError:
        return "Error: TARGET_TEXT not defined. Please complete Step 1 first."
    
    # Get competency score from Step 2
    try:
        human_competency = flow.get_score()
    except:
        human_competency = 50.0  # Default if not available
    
    # Get rubrics from Step 2.5 (optional)
    try:
        rubrics = EVALUATION_RUBRICS if EVALUATION_RUBRICS else ""
    except:
        rubrics = ""
    
    # Build evaluation context
    context = EvaluationContext(
        target_text=TARGET_TEXT,
        evaluation_purpose=EVALUATION_PURPOSE if 'EVALUATION_PURPOSE' in globals() else 'General Assessment',
        human_competency_score=human_competency,
        evaluation_rubrics=rubrics,
        human_score=int(human_score),
        human_reason=human_reason,
    )
    
    output_lines = []
    output_lines.append("=" * 60)
    output_lines.append("JURY EVALUATION SYSTEM - Multi-Agent with Debate")
    output_lines.append("=" * 60)
    output_lines.append("")
    output_lines.append(f"Target Text: {TARGET_TEXT[:100]}...")
    output_lines.append(f"Human Competency Score: {human_competency:.2f}")
    output_lines.append(f"Your Score: {human_score}")
    output_lines.append(f"Your Reason: {human_reason[:100]}...")
    output_lines.append("")
    
    if rubrics:
        output_lines.append(f"Using provided rubrics ({len(rubrics)} chars)")
    else:
        output_lines.append("No rubrics provided. Using internal criteria.")
    output_lines.append("")
    
    try:
        # Run the evaluation (async)
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        try:
            JURY_STATE = loop.run_until_complete(jury_system.run(context))
        finally:
            loop.close()
        
        # Format results
        output_lines.append("")
        output_lines.append("=" * 60)
        output_lines.append("EVALUATION RESULTS")
        output_lines.append("=" * 60)
        output_lines.append("")
        
        # Initial evaluations
        output_lines.append("--- Judge Evaluations ---")
        for eval in JURY_STATE.evaluations:
            output_lines.append(f"")
            output_lines.append(f"{eval.role}: {eval.score}/100")
            output_lines.append(f"  Reason: {eval.reason[:150]}...")
            if eval.dispute_to:
                output_lines.append(f"  [Disputed: {eval.dispute_to}]")
        
        # Debates
        if JURY_STATE.debates:
            output_lines.append("")
            output_lines.append("--- Debate Summaries ---")
            for debate in JURY_STATE.debates:
                output_lines.append(f"")
                output_lines.append(f"{debate.initiator_id} vs {debate.target_id}")
                output_lines.append(f"  Point: {debate.dispute_point[:80]}...")
                output_lines.append(f"  {debate.initiator_id}: {debate.initiator_original_score} -> {debate.initiator_new_score}")
                output_lines.append(f"  {debate.target_id}: {debate.target_original_score} -> {debate.target_new_score}")
        
        # Voting results
        if JURY_STATE.vote_result:
            output_lines.append("")
            output_lines.append("--- Voting Results ---")
            output_lines.append(f"Winner: {JURY_STATE.vote_result.winner_author} ({JURY_STATE.vote_result.winner_option})")
            output_lines.append(f"Vote Counts: {JURY_STATE.vote_result.vote_counts}")
        
        # Final score
        output_lines.append("")
        output_lines.append("--- Final Score ---")
        output_lines.append(f"Weighted Final Score: {JURY_STATE.final_score:.2f}/100")
        output_lines.append("")
        output_lines.append("Weights:")
        for name, weight in JURY_STATE.weights.items():
            output_lines.append(f"  {name}: {weight:.2f}")
        
        # Final report
        output_lines.append("")
        output_lines.append("=" * 60)
        output_lines.append("FINAL REPORT")
        output_lines.append("=" * 60)
        output_lines.append("")
        output_lines.append(JURY_STATE.final_report)
        
        return "\n".join(output_lines)
        
    except Exception as e:
        import traceback
        error_msg = f"Error during evaluation: {str(e)}\n\n{traceback.format_exc()}"
        return error_msg

# Create Gradio interface
with gr.Blocks(title="Step 3: Jury Evaluation") as step3_demo:
    gr.Markdown("# Step 3: Multi-Agent Jury Evaluation")
    gr.Markdown("""
This step runs the complete jury evaluation with the following phases:

1. **Phase 1 - Initial Evaluation**: 4 specialized judges (Logic, Expression, Utility, Moral) independently evaluate the target text
